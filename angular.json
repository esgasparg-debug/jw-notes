{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "37976816-97b2-4cbd-a697-c1cdb072ffd3"
  },
  "newProjectRoot": "projects",
  "projects": {
    "jw-notes": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "defaultConfiguration": "production",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "sql-wasm-browser.wasm",
                "input": "node_modules/sql.js/dist",
                "output": "assets/sqljs"
              },
              {
                "glob": "sql-wasm.wasm",
                "input": "node_modules/sql.js/dist",
                "output": "assets/sqljs"
              }
            ],
            "styles": [
              "node_modules/@fontsource/noto-sans/400.css",
              "node_modules/@fontsource/noto-sans/500.css",
              "node_modules/@fontsource/noto-sans/600.css",
              "node_modules/material-symbols/rounded.css",
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles"
              ]
            },
            "allowedCommonJsDependencies": [
              "jszip",
              "sql.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "defaultConfiguration": "development",
          "configurations": {
            "production": {
              "buildTarget": "jw-notes:build:production"
            },
            "development": {
              "buildTarget": "jw-notes:build:development"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "providersFile": "src/test-providers.ts"
          }
        }
      }
    }
  }
}
