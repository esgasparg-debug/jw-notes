{
  "name": "jw-notes",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "desktop:start": "ng build --configuration development && electron .",
    "desktop:dist": "ng build && electron-builder",
    "mobile:add:android": "cap add android && node scripts/setup-android.cjs",
    "mobile:add:ios": "cap add ios",
    "mobile:sync": "ng build && cap sync && node scripts/setup-android.cjs",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@azure/msal-browser": "^5.27.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@fontsource/noto-sans": "^5.3.0",
    "jszip": "^3.10.2",
    "material-symbols": "^0.48.2",
    "rxjs": "~7.8.0",
    "sql.js": "^1.15.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/sql.js": "^1.4.11",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "Editor e mesclador de backups do JW Library (Angular, empacotável com Electron e Capacitor).",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "org.example.jwnotes",
    "productName": "Editor de Notas",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/jw-notes/browser/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
